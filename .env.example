# Copy this file to .env and fill in. NEVER share .env.

# ---- MongoDB (Atlas or self-hosted) ----
MONGO_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=nexus_smc_bot

# ---- Upstox (https://account.upstox.com/developer/apps) ----
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/callback
# Optional: paste a token directly (valid till ~3:30 AM next day). Otherwise use: python main.py login upstox
UPSTOX_ACCESS_TOKEN=

# ---- Zerodha Kite Connect (https://developers.kite.trade) ----
KITE_API_KEY=
KITE_API_SECRET=
# Optional: paste a token directly (valid till ~6 AM next day). Otherwise use: python main.py login zerodha
KITE_ACCESS_TOKEN=

# ---- Telegram alerts ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard login password (strongly recommended when the dashboard runs on a VPS)
DASHBOARD_PASSWORD=
